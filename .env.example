# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API
# NEVER commit .env.local to git (it is already in .gitignore).

# Public - safe to expose in the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Secret - server-side only, NEVER expose in client code or commit to git.
# Used only in server actions / route handlers for admin-only operations
# that must bypass Row Level Security (e.g. some storage cleanup tasks).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
